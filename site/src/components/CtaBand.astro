---
import { site } from '../data/site';

// Stage 2: mailto CTA. Stage 4 replaces this with the capture form.
---

<section id="waitlist" class="section band--ink" aria-labelledby="waitlist-title">
  <div class="container cta-band">
    <div>
      <p class="kicker">{site.waitlist.kicker}</p>
      <h2 id="waitlist-title" class="section-title">{site.waitlist.title}</h2>
      <p class="section-lede">{site.waitlist.body}</p>
    </div>
    <div class="cta-action">
      <a class="btn btn--primary" href={`mailto:${site.contactEmail}`}>
        {site.waitlist.ctaLabel}
      </a>
      <p class="cta-email">
        or write to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-band {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .cta-action {
    justify-self: end;
    text-align: right;
  }

  .cta-email {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .cta-email a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 720px) {
    .cta-band {
      grid-template-columns: 1fr;
    }

    .cta-action {
      justify-self: start;
      text-align: left;
    }
  }
</style>
