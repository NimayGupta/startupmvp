---
import { site } from '../data/site';
import WaitlistForm from './WaitlistForm.astro';

// With PUBLIC_FORM_ENDPOINT set at build time the band renders the inline
// capture form; without it, the button links out to the early-access
// signup form (site.requestAccessUrl), with the contact email below.
const hasForm = Boolean(import.meta.env.PUBLIC_FORM_ENDPOINT);
---

<section id="waitlist" class="section band--ink" aria-labelledby="waitlist-title">
  <div class={`container cta-band${hasForm ? ' has-form' : ''}`}>
    <div>
      <p class="kicker">{site.waitlist.kicker}</p>
      <h2 id="waitlist-title" class="section-title">{site.waitlist.title}</h2>
      <p class="section-lede">{site.waitlist.body}</p>
      {hasForm && <WaitlistForm />}
    </div>
    {
      !hasForm && (
        <div class="cta-action">
          <a
            class="btn btn--primary"
            href={site.requestAccessUrl}
            target="_blank"
            rel="noopener"
          >
            {site.waitlist.ctaLabel}
          </a>
        </div>
      )
    }
  </div>
  <div class="container">
    <p class="cta-email">
      or write to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </p>
  </div>
</section>

<style>
  .cta-band {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .cta-band.has-form {
    grid-template-columns: 1fr;
  }

  .cta-action {
    justify-self: end;
  }

  .cta-email {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .cta-email a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 720px) {
    .cta-band {
      grid-template-columns: 1fr;
    }

    .cta-action {
      justify-self: start;
    }
  }
</style>
