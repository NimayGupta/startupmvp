---
import { seededRows, statusLabels, counters } from '../data/ledger';

// Progressively enhanced: the 6 seeded rows render server-side, so the
// panel is complete with JS disabled. The client script below streams new
// rows unless the user prefers reduced motion.
const summary =
  'A live preview of the Margent decision ledger: a stream of pricing ' +
  'decisions with their test status, profit delta, and confidence. ' +
  'Simulated data for illustration.';
---

<div class="ledger" role="img" aria-label={summary}>
  <div class="ledger-inner" aria-hidden="true">
    <header class="ledger-head">
      <span class="ledger-dot"></span>
      <span class="ledger-title">Decision ledger</span>
      <span class="ledger-tag">simulated preview</span>
    </header>

    <ul class="ledger-rows" id="ledger-rows">
      {
        seededRows.map((row) => (
          <li class={`ledger-row is-${row.status}`}>
            <span class="cell-sku">{row.sku}</span>
            <span class="cell-action">{row.action}</span>
            <span class="cell-status">{statusLabels[row.status]}</span>
            <span class="cell-delta">{row.delta}</span>
            <span class="cell-conf">{row.confidence}</span>
          </li>
        ))
      }
    </ul>

    <footer class="ledger-foot">
      <span>
        <strong id="counter-experiments">{counters.experiments.toLocaleString('en-US')}</strong>
        {counters.experimentsLabel}
      </span>
      <span>
        <strong id="counter-lift">{counters.netLift}</strong>
        {counters.netLiftLabel}
      </span>
    </footer>
  </div>
</div>

<style>
  .ledger {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .ledger-inner {
    background: var(--ink-2);
    border: 1px solid var(--line-on-ink);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .ledger-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line-on-ink);
  }

  .ledger-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal-bright);
    flex-shrink: 0;
  }

  .ledger-title {
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-ink);
  }

  .ledger-tag {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--muted-on-ink);
    border: 1px solid var(--line-on-ink);
    border-radius: 99px;
    padding: 0.1em 0.7em;
  }

  .ledger-rows {
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0;
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 5.5em 1fr 5.5em 4em 3em;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) var(--space-4);
    color: var(--muted-on-ink);
    white-space: nowrap;
  }

  .cell-sku {
    color: var(--text-on-ink);
  }

  .cell-status {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .is-kept .cell-status,
  .is-kept .cell-delta {
    color: var(--teal-bright);
  }

  .is-testing .cell-status {
    color: var(--amber-bright);
  }

  .is-reverted .cell-status,
  .is-reverted .cell-delta {
    color: var(--red-bright);
  }

  .cell-delta,
  .cell-conf {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .ledger-foot {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line-on-ink);
    font-size: var(--text-xs);
    color: var(--muted-on-ink);
    flex-wrap: wrap;
  }

  .ledger-foot strong {
    color: var(--text-on-ink);
    font-weight: 500;
    margin-right: 0.4em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 420px) {
    .ledger-row {
      grid-template-columns: 5.5em 1fr 4em;
    }

    .cell-status,
    .cell-conf {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ledger-row.is-new {
      animation: row-in var(--dur-med) var(--ease-out);
    }
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { pools, counters, statusLabels, type LedgerStatus } from '../data/ledger';

  const list = document.getElementById('ledger-rows');
  const expEl = document.getElementById('counter-experiments');
  const liftEl = document.getElementById('counter-lift');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (list && expEl && liftEl && !reduced.matches) {
    let experiments = counters.experiments;
    let lift = parseFloat(counters.netLift);
    const rand = (min: number, max: number) => min + Math.random() * (max - min);
    const pick = <T,>(arr: readonly T[]) => arr[Math.floor(Math.random() * arr.length)];

    const makeRow = () => {
      const r = Math.random();
      const status: LedgerStatus = r < 0.5 ? 'kept' : r < 0.8 ? 'testing' : 'reverted';
      const delta =
        status === 'kept'
          ? `+${rand(0.6, 3.8).toFixed(1)}%`
          : status === 'reverted'
            ? `−${rand(0.4, 1.8).toFixed(1)}%`
            : '—';
      const confidence = (status === 'testing' ? rand(0.5, 0.85) : rand(0.9, 0.99)).toFixed(2);
      const sku = `SKU-${String(Math.floor(rand(pools.skuRange[0], pools.skuRange[1]))).padStart(4, '0')}`;

      const li = document.createElement('li');
      li.className = `ledger-row is-${status} is-new`;
      for (const [cls, text] of [
        ['cell-sku', sku],
        ['cell-action', pick(pools.actions)],
        ['cell-status', statusLabels[status]],
        ['cell-delta', delta],
        ['cell-conf', confidence],
      ]) {
        const span = document.createElement('span');
        span.className = cls;
        span.textContent = text;
        li.append(span);
      }
      li.addEventListener('animationend', () => li.classList.remove('is-new'), { once: true });

      if (status !== 'testing') {
        experiments += 1;
        expEl.textContent = experiments.toLocaleString('en-US');
        lift = Math.max(0, lift + (status === 'kept' ? rand(0.005, 0.03) : -rand(0.002, 0.015)));
        liftEl.textContent = `+${lift.toFixed(1)}%`;
      }
      return li;
    };

    let timer: number | undefined;
    let onScreen = false;
    const tick = () => {
      list.prepend(makeRow());
      while (list.children.length > 6) list.lastElementChild?.remove();
      timer = window.setTimeout(tick, rand(2200, 3600));
    };
    const sync = () => {
      const shouldRun = onScreen && !document.hidden && !reduced.matches;
      if (shouldRun && timer === undefined) timer = window.setTimeout(tick, 1200);
      if (!shouldRun && timer !== undefined) {
        window.clearTimeout(timer);
        timer = undefined;
      }
    };

    // Stream only while the panel is on screen and the tab is visible.
    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        sync();
      },
      { threshold: 0.2 }
    ).observe(list);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
  }
</script>
