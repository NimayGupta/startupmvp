  bag: 'M5 8h14l-1.2 12.2a1.8 1.8 0 0 1-1.8 1.6H8a1.8 1.8 0 0 1-1.8-1.6L5 8ZM8.5 8V6.5a3.5 3.5 0 0 1 7 0V8',
  rows: 'M4 5.5h16M4 10.5h16M4 15.5h10M4 20.5h7',
