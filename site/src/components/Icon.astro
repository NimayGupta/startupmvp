---
// Inline SVG icon set. One consistent family: 24px grid, 1.75 stroke,
// round caps, no fills. Add icons here, reference by name in data files.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 22 } = Astro.props;

const paths: Record<string, string> = {
